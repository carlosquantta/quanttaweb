---
import CasoLayout from '../../layouts/CasoLayout.astro';
---

<CasoLayout title="Flux — Caso de éxito">
  <Fragment slot="head">
<style>
/* ── TOKENS ── */
:root {
  --ground: #fdf9ed;
  --surface: #ffffff;
  --surface-2: #f2eee2;
  --ink: #1d1c15;
  --ink-mid: #434843;
  --ink-faint: #737973;
  --lime: #D4F953;
  --lime-alt: #c6f33e;
  --lime-wash: rgba(198,243,62,0.12);
  --blue: #80A9DA;
  --dark: #1c1005;
  --border: rgba(27,48,34,0.1);
  --border-faint: rgba(27,48,34,0.06);
  --shadow: 0 1px 2px rgba(0,0,0,.04), 0 8px 24px -12px rgba(0,0,0,.1);
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --ground: #100e05; --surface: #1a1200; --surface-2: #231900;
    --ink: #ede9df; --ink-mid: #b0a98e; --ink-faint: #7a7260;
    --dark: #0d0800;
    --border: rgba(255,255,255,0.08); --border-faint: rgba(255,255,255,0.04);
    --shadow: 0 1px 3px rgba(0,0,0,.4), 0 10px 28px -14px rgba(0,0,0,.7);
  }
}
:root[data-theme="dark"] {
  --ground: #100e05; --surface: #1a1200; --surface-2: #231900;
  --ink: #ede9df; --ink-mid: #b0a98e; --ink-faint: #7a7260;
  --dark: #0d0800;
  --border: rgba(255,255,255,0.08); --border-faint: rgba(255,255,255,0.04);
  --shadow: 0 1px 3px rgba(0,0,0,.4), 0 10px 28px -14px rgba(0,0,0,.7);
}

/* ── BASE ── */
*, ::before, ::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  background: var(--ground);
  color: var(--ink);
  font-family: "Manrope", system-ui, sans-serif;
  -webkit-font-smoothing: antialiased;
  line-height: 1.6;
}

/* ── NAV ── */
.nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 50;
  background: rgba(248,247,242,0.82);
  backdrop-filter: blur(16px) saturate(1.4);
  border-bottom: 1px solid rgba(27,48,34,0.10);
  height: 64px;
  display: flex; align-items: center;
}
.nav-inner {
  max-width: 1440px; margin: 0 auto; width: 100%;
  padding: 0 clamp(20px,5vw,48px);
  display: flex; align-items: center; justify-content: space-between; gap: 24px;
}
.nav-logo { height: 24px; width: auto; display: block; }
.nav-links { display: flex; align-items: center; gap: 28px; }
@media (max-width: 640px) { .nav-links { display: none; } }
.nav-links a {
  font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
  color: rgba(27,48,34,0.5); text-decoration: none; transition: color .2s;
}
.nav-links a:hover { color: #1B3022; }
.nav-cta {
  font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
  color: #1B3022; text-decoration: none;
  background: var(--lime); padding: 7px 16px; border-radius: 999px;
  white-space: nowrap; transition: transform .2s;
}
.nav-cta:hover { transform: translateY(-1px); }

/* ── MESH utilities ── */
.mesh-blob {
  position: absolute;
  border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%;
  filter: blur(130px); opacity: 0.28;
  animation: meshMove infinite alternate ease-in-out;
  pointer-events: none; z-index: 0;
}
.blob-lime { background: #C8FF3A; }
.blob-blue { background: #6B9ED4; }
@keyframes meshMove {
  0%   { transform: translate(0,0) rotate(0deg) scale(1); }
  100% { transform: translate(24vw,16vh) rotate(75deg) scale(1.22); }
}
.mesh-grain {
  position: absolute; inset: 0; z-index: 1; pointer-events: none; opacity: 0.08;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='1.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
}

/* ─────────────────────────────────────────────────
   VIEWPORT 1 — hero + reto (dark, full height)
───────────────────────────────────────────────── */
.vp1 {
  min-height: 100svh;
  background: var(--dark);
  position: relative; overflow: hidden;
  display: grid;
  grid-template-rows: 1fr auto;
  padding-top: 64px; /* nav */
}
.vp1-rel { position: relative; z-index: 2; display: contents; }

.vp1-main {
  display: grid;
  grid-template-columns: 58% 42%;
  align-items: center;
}

/* left: identity */
.vp1-left {
  padding: clamp(32px,5vh,64px) clamp(20px,4vw,64px) clamp(32px,5vh,64px) clamp(24px,5vw,80px);
  position: relative; z-index: 2;
}
.eyebrow {
  display: inline-flex; align-items: center; gap: 10px;
  font-size: 10px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--lime-alt); margin-bottom: 16px;
}
.eyebrow::before {
  content: ""; width: 18px; height: 2px; background: var(--lime-alt);
  border-radius: 2px; flex-shrink: 0;
}
.hero-logo {
  display: block; height: clamp(56px,9vw,104px); width: auto; margin-bottom: 20px;
}
.hero-lede {
  font-size: clamp(15px,1.5vw,18px); color: rgba(255,255,255,0.52);
  max-width: 48ch; line-height: 1.55; margin-bottom: 20px;
}
.hero-lede strong { color: rgba(255,255,255,0.85); font-weight: 600; }
.chips { display: flex; flex-wrap: wrap; gap: 7px; }
.chip {
  font-size: 11px; font-weight: 600; letter-spacing: 0.03em;
  color: rgba(255,255,255,0.5);
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.09);
  border-radius: 999px; padding: 5px 12px;
}
.chip strong { color: rgba(255,255,255,0.82); font-weight: 700; }

/* right: reto compact */
.vp1-right {
  border-left: 1px solid rgba(255,255,255,0.06);
  padding: clamp(28px,4vh,52px) clamp(20px,3vw,44px);
  position: relative; z-index: 2;
  align-self: stretch;
  display: flex; flex-direction: column; justify-content: center;
}
.reto-lbl {
  font-size: 10px; font-weight: 700; letter-spacing: 0.13em; text-transform: uppercase;
  color: var(--lime-alt); opacity: 0.8; margin-bottom: 12px;
}
.reto-head {
  font-family: "Newsreader", Georgia, serif;
  font-size: clamp(17px,1.6vw,22px); font-weight: 500; line-height: 1.28;
  color: rgba(255,255,255,0.78); text-wrap: balance; margin-bottom: 20px;
  letter-spacing: -0.01em;
}
.reto-cols {
  display: grid; grid-template-columns: 1fr 1fr; gap: 10px;
}
.rc {
  border-radius: 10px; padding: 14px 16px;
  display: flex; flex-direction: column; gap: 8px;
}
.rc-antes {
  background: rgba(255,80,60,0.05);
  border: 1px solid rgba(255,80,60,0.13);
}
.rc-despues {
  background: rgba(198,243,62,0.06);
  border: 1px solid rgba(198,243,62,0.18);
}
.rc-badge {
  display: inline-flex; align-items: center; gap: 5px;
  font-size: 9px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
  padding: 3px 8px; border-radius: 999px; width: fit-content; margin-bottom: 2px;
}
.rc-antes .rc-badge { background: rgba(255,80,60,0.1); color: rgba(255,120,100,0.9); }
.rc-despues .rc-badge { background: rgba(198,243,62,0.12); color: var(--lime-alt); }
.ri {
  font-size: 12px; line-height: 1.45; color: rgba(255,255,255,0.42);
  padding-left: 10px; border-left: 1px solid rgba(255,255,255,0.07);
}
.rc-despues .ri { color: rgba(255,255,255,0.5); border-left-color: rgba(198,243,62,0.18); }

/* bottom stats strip */
.vp1-stats {
  display: grid; grid-template-columns: repeat(4,1fr);
  border-top: 1px solid rgba(255,255,255,0.07);
  position: relative; z-index: 2;
}
.vp1-stat {
  padding: 18px clamp(20px,3vw,48px);
  border-right: 1px solid rgba(255,255,255,0.06);
}
.vp1-stat:last-child { border-right: 0; }
.vp1-stat-num {
  font-family: "Newsreader", Georgia, serif;
  font-size: clamp(26px,3vw,38px); font-weight: 500; letter-spacing: -0.02em; line-height: 1;
  color: var(--lime-alt); font-variant-numeric: tabular-nums;
}
.vp1-stat-lbl {
  margin-top: 5px; font-size: 11px; line-height: 1.4; color: rgba(255,255,255,0.35);
}

/* ─────────────────────────────────────────────────
   VIEWPORT 2 — features + distingue + CTA/footer
───────────────────────────────────────────────── */
.vp2 {
  min-height: calc(100svh - 0px);
  background: var(--ground);
  display: grid;
  grid-template-rows: 1fr auto auto;
}

/* pillars */
.vp2-pillars {
  padding: clamp(28px,4vh,48px) clamp(24px,5vw,80px) 0;
}
.sec-lbl {
  font-size: 10px; font-weight: 700; letter-spacing: 0.13em; text-transform: uppercase;
  color: var(--ink-faint); margin-bottom: 14px;
}
.pillars {
  display: grid; grid-template-columns: repeat(3,1fr); gap: 1px;
  background: var(--border-faint);
  border: 1px solid var(--border-faint); border-radius: 14px; overflow: hidden;
}
.pillar {
  background: var(--surface); padding: 20px 22px;
}
.pillar-head {
  display: flex; align-items: center; gap: 8px; margin-bottom: 2px;
}
.dot { width: 7px; height: 7px; border-radius: 2px; flex-shrink: 0; }
.p1 .dot { background: var(--lime-alt); }
.p2 .dot { background: var(--blue); }
.p3 .dot { background: #c6a020; }
.pillar-head h3 {
  font-family: "Newsreader", Georgia, serif;
  font-size: 16px; font-weight: 500; letter-spacing: -0.01em;
  color: var(--ink); margin: 0;
}
.pillar-tag {
  font-size: 9.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--ink-faint); margin: 0 0 14px;
}
.feat {
  padding: 9px 0; border-top: 1px solid var(--border-faint);
}
.feat:first-of-type { border-top: 0; }
.feat p {
  font-size: 13px; color: var(--ink-mid); line-height: 1.5; margin: 0;
}
.feat p strong { font-weight: 700; color: var(--ink); }

/* lo que lo distingue */
.vp2-diff {
  padding: clamp(24px,3vh,40px) clamp(24px,5vw,80px) 0;
}
.diff-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 8px;
  margin-top: 14px;
}
.diff-item {
  padding: 14px 16px; border-radius: 10px;
  border: 1px solid var(--border-faint);
  font-size: 13px; line-height: 1.55; color: var(--ink-mid);
  background: var(--surface);
}
.diff-item strong { color: var(--ink); font-weight: 600; }

/* CTA + footer combined */
.vp2-bottom {
  margin-top: clamp(24px,3vh,40px);
  background: var(--dark);
  position: relative; overflow: hidden;
}
.vp2-bottom::before {
  content: "";
  position: absolute; width: 400px; height: 400px; border-radius: 50%;
  background: radial-gradient(circle, rgba(212,249,83,0.08) 0%, transparent 70%);
  top: -160px; right: -60px; pointer-events: none;
}
.cta-row {
  position: relative; z-index: 1;
  display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
  gap: 20px;
  padding: clamp(28px,4vh,44px) clamp(24px,5vw,80px);
  border-bottom: 1px solid rgba(255,255,255,0.06);
}
.cta-copy {
  font-family: "Newsreader", Georgia, serif;
  font-size: clamp(18px,2vw,24px); font-weight: 500; letter-spacing: -0.015em;
  color: #fff; max-width: 36ch; text-wrap: balance;
}
.cta-link {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
  color: #1d1c15; background: var(--lime);
  text-decoration: none; padding: 12px 22px; border-radius: 999px;
  white-space: nowrap; transition: transform .2s, box-shadow .2s;
  flex-shrink: 0;
}
.cta-link:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(212,249,83,0.28); }
.footer-row {
  position: relative; z-index: 1;
  display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap;
  gap: 12px;
  padding: 16px clamp(24px,5vw,80px);
}
.footer-logo { height: 28px; width: auto; opacity: 0.6; }
.footer-links {
  display: flex; align-items: center; gap: 20px;
}
.footer-links a, .footer-copy {
  font-family: "Newsreader", Georgia, serif;
  font-size: 11px; letter-spacing: 0.04em; color: rgba(255,255,255,0.28);
  text-decoration: none; transition: color .2s;
}
.footer-links a:hover { color: rgba(255,255,255,0.55); }
.footer-links a { text-decoration: underline; }

/* ── RESPONSIVE ── */
@media (max-width: 900px) {
  .vp1-main { grid-template-columns: 1fr; }
  .vp1-right { border-left: none; border-top: 1px solid rgba(255,255,255,0.06); }
  .vp1-stats { grid-template-columns: repeat(2,1fr); }
  .pillars { grid-template-columns: 1fr; }
  .diff-grid { grid-template-columns: 1fr; }
  .vp2 { min-height: unset; }
}
@media (max-width: 540px) {
  .reto-cols { grid-template-columns: 1fr; }
  .vp1-stats { grid-template-columns: 1fr 1fr; }
  .footer-row { flex-direction: column; align-items: flex-start; }
}
@media (prefers-reduced-motion: reduce) {
  .mesh-blob { animation: none; }
  .cta-link { transition: none; }
}
</style>
  </Fragment>

<!-- NAV -->
<nav class="nav">
  <div class="nav-inner">
    <a href="https://www.quantta.mx">
      <img class="nav-logo" src="/index_files/horizontal-cafe.svg" alt="Quantta">
    </a>
    <div class="nav-links">
      <a href="https://www.quantta.mx/#experiencia">Experiencia</a>
      <a href="https://www.quantta.mx/#enfoque">Enfoque</a>
      <a href="https://www.quantta.mx/#metodo">Método</a>
    </div>
    <a href="https://www.quantta.mx/#contacto" class="nav-cta">Charlemos</a>
  </div>
</nav>

<!-- ── VIEWPORT 1: hero + reto ── -->
<section class="vp1">
  <div class="mesh-blob blob-lime" style="width:32vw;height:32vw;top:-8%;left:-4%;animation-duration:13s;"></div>
  <div class="mesh-blob blob-blue" style="width:26vw;height:26vw;top:30%;right:-4%;animation-duration:18s;animation-delay:-6s;"></div>
  <div class="mesh-blob blob-lime" style="width:16vw;height:20vw;bottom:12%;right:18%;animation-duration:21s;animation-delay:-4s;opacity:0.18;"></div>
  <div class="mesh-grain"></div>

  <div class="vp1-main vp1-rel">
    <!-- identidad -->
    <div class="vp1-left">
      <span class="eyebrow">Caso de éxito</span>
      <img class="hero-logo" src="/index_files/flux_nat.webp" alt="Flux">
      <p class="hero-lede">Dos años transformando la operación financiera de un grupo empresarial mexicano — <strong>criterio estratégico integrado</strong> y un sistema a la medida.</p>
      <div class="chips">
        <span class="chip"><strong>2 años</strong> · acompañamiento continuo</span>
        <span class="chip"><strong>Multiempresa</strong> · reglas propias</span>
        <span class="chip"><strong>CONTPAQi</strong> · integrado</span>
        <span class="chip"><strong>En producción</strong> · operación diaria</span>
      </div>
    </div>

    <!-- reto compacto -->
    <div class="vp1-right">
      <p class="reto-lbl">El reto</p>
      <p class="reto-head">Varias empresas, un mismo dinero — el control viviendo en hojas de cálculo.</p>
      <div class="reto-cols">
        <div class="rc rc-antes">
          <span class="rc-badge">Antes</span>
          <div class="ri">Pagos por WhatsApp, aprobados de palabra</div>
          <div class="ri">Recaptura manual en contabilidad</div>
          <div class="ri">Sin presupuesto real ni rastro</div>
        </div>
        <div class="rc rc-despues">
          <span class="rc-badge">Con Quantta</span>
          <div class="ri">Solicitud con rastro permanente</div>
          <div class="ri">Póliza automática al pagar</div>
          <div class="ri">Presupuesto vivo, sin excepciones</div>
        </div>
      </div>
    </div>
  </div>

  <!-- stats strip -->
  <div class="vp1-stats vp1-rel">
    <div class="vp1-stat">
      <div class="vp1-stat-num">1</div>
      <div class="vp1-stat-lbl">plataforma para todo el grupo</div>
    </div>
    <div class="vp1-stat">
      <div class="vp1-stat-num">0</div>
      <div class="vp1-stat-lbl">recapturas entre pago y contabilidad</div>
    </div>
    <div class="vp1-stat">
      <div class="vp1-stat-num">2 años</div>
      <div class="vp1-stat-lbl">de acompañamiento continuo</div>
    </div>
    <div class="vp1-stat">
      <div class="vp1-stat-num">100%</div>
      <div class="vp1-stat-lbl">de pagos con autorización y rastro</div>
    </div>
  </div>
</section>

<!-- ── VIEWPORT 2: sistema + distingue + CTA ── -->
<section class="vp2">

  <!-- pillars -->
  <div class="vp2-pillars">
    <p class="sec-lbl">El sistema que lo sostiene</p>
    <div class="pillars">
      <div class="pillar p1">
        <div class="pillar-head"><span class="dot"></span><h3>Control del gasto</h3></div>
        <p class="pillar-tag">Antes de pagar</p>
        <div class="feat"><p><strong>Presupuesto vivo,</strong> cada solicitud se valida contra su partida en el momento.</p></div>
        <div class="feat"><p><strong>Portal de proveedores,</strong> suben sus facturas y reciben la notificación del pago.</p></div>
        <div class="feat"><p><strong>Autorización trazable,</strong> siempre queda quién aprobó, monto y cuándo.</p></div>
      </div>
      <div class="pillar p2">
        <div class="pillar-head"><span class="dot"></span><h3>Contabilidad sin fricción</h3></div>
        <p class="pillar-tag">Del pago a la póliza</p>
        <div class="feat"><p><strong>La factura se lee sola,</strong> Flux extrae importes, impuestos y retenciones del CFDI.</p></div>
        <div class="feat"><p><strong>Clasificación asistida,</strong> el sistema sugiere partida y cuenta; el equipo confirma.</p></div>
        <div class="feat"><p><strong>Póliza para CONTPAQi,</strong> lo que era recaptura manual hoy es un botón de exportar.</p></div>
      </div>
      <div class="pillar p3">
        <div class="pillar-head"><span class="dot"></span><h3>Hecho para un grupo</h3></div>
        <p class="pillar-tag">Una plataforma, varias empresas</p>
        <div class="feat"><p><strong>Multiempresa real,</strong> cada empresa opera con sus datos aislados y sus reglas.</p></div>
        <div class="feat"><p><strong>Cada quien ve lo suyo,</strong> permisos por rol y empresa hasta el nivel de cada registro.</p></div>
        <div class="feat"><p><strong>Visión consolidada,</strong> la dirección ve el grupo; cada empresa, su operación.</p></div>
      </div>
    </div>
  </div>

  <!-- lo que distingue -->
  <div class="vp2-diff">
    <p class="sec-lbl">Lo que lo distingue</p>
    <div class="diff-grid">
      <div class="diff-item"><strong>Autogestión de proveedores —</strong> cada proveedor sube sus comprobantes, sigue el proceso y recibe el pago sin intermediarios.</div>
      <div class="diff-item"><strong>Cero recaptura —</strong> la factura entra una vez; del CFDI a la póliza contable sin volver a teclear nada.</div>
      <div class="diff-item"><strong>Clasificación asistida —</strong> el sistema sugiere, el equipo confirma. No adivina.</div>
      <div class="diff-item"><strong>Disciplina financiera —</strong> ningún gasto avanza sin pasar por su partida; las excepciones quedan firmadas.</div>
    </div>
  </div>

  <!-- CTA + footer -->
  <div class="vp2-bottom">
    <div class="cta-row">
      <p class="cta-copy">¿Tu operación financiera sigue viviendo en hojas de cálculo?</p>
      <a href="https://www.quantta.mx/#contacto" class="cta-link">Hablemos → quantta.mx</a>
    </div>
    <div class="footer-row">
      <img class="footer-logo" src="/index_files/slogan-cafe.svg" alt="Quantta">
      <div class="footer-links">
        <a href="/legal">Aviso de Privacidad · Términos · Cookies</a>
        <span class="footer-copy">© 2026 Quantta Strategic Consulting</span>
      </div>
    </div>
  </div>

</section>

</CasoLayout>
